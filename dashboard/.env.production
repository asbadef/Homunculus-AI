# Production build settings for the Vercel deployment.
#
# VITE_API_URL is baked into the bundle at build time. Without it, defaultBaseUrl() returns "" and
# every API call goes to the frontend's own origin — where a static host answers /auth/login with
# 405 and the login screen reports a failure that names neither the cause nor the backend. Keeping
# it in the repo (rather than a dashboard env var) means a fresh clone deploys and works, and the
# frontend cannot silently drift away from the API it was built against.
#
# This is a public URL, not a secret: it is visible in the shipped bundle and in every request the
# browser makes. Secrets belong in the Render dashboard, never here.
VITE_API_URL=https://homunculus-api-bkrf.onrender.com
