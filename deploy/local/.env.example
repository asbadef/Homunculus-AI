# Copy to `.env` next to docker-compose.yml, fill in, and lock it down:
#   cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored. Nothing in this file may be committed with a real value.

# Postgres. This database holds real patient data; treat the password accordingly.
#
# Generate it — do not invent one:
#   openssl rand -base64 36
#
# It must NOT contain an "@". This value is interpolated into DATABASE_URL
# (postgresql://homunculus:<password>@postgres:5432/homunculus), and an "@" splits the URL in the
# wrong place: the host becomes something like "cd@postgres" and the API fails with a name
# resolution error that never mentions the password. `openssl rand -base64` cannot emit "@", which
# is the other reason to generate rather than invent. "/", "+" and "=" are all safe.
POSTGRES_PASSWORD=change-me

# Signing key for session tokens. Generate one, do not invent one:
#   openssl rand -base64 36
JWT_SECRET=change-me

# Tenant bearer token used by the bridge to POST observations. This is a WRITE credential: it
# authorises /ingest. Generate it the same way as JWT_SECRET; do not reuse "pilot-token".
TENANT_TOKEN=change-me

# The tenant slug this deployment runs as. This is not just a label: it IS the engine's hospital
# key. docker-compose.yml uses it twice — once in TENANTS (so the bridge's token and any clinician
# JWT resolve to this hospital) and once in SEED_TENANT_SLUG (so seed_admin.py creates the admin
# account under that same hospital). If those two ever named different slugs, the admin would be
# seeded into a tenant nothing else points at: login would succeed, but the board — and everything
# the bridge feeds in — would silently stay empty, because the pieces would each be talking about a
# different hospital that happens to share a token. Leave it as the default unless you know you are
# running more than one tenant on this host.
TENANT_SLUG=demo-hastanesi

# First administrator, created on the first start. The email must pass the login API's validation
# (".local" and "localhost" domains are rejected).
#
# NOTE: seeding is idempotent and SKIPS an existing user. Changing this password later does NOT
# change the account's password — there is no password-change flow yet.
SEED_ADMIN_EMAIL=admin@hastane.com.tr
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Sistem Yöneticisi

# The interface the MLLP port binds to — the one facing the device network, never 0.0.0.0.
# MLLP is plain text with no authentication.
LISTEN_ADDR=172.100.101.72

# The interface the dashboard is served on.
WEB_LISTEN_ADDR=172.100.101.72

# Host port for the dashboard. 80 unless something already owns it — a server that has run anything
# else web-facing usually has Apache or nginx holding *:80 on every interface, and Docker then
# fails to bind with "address already in use". Moving this is far less disruptive than stopping
# whatever that other service is doing.
WEB_PORT=80

# Container timezone. The engine reasons about observation timestamps, so a host and a monitor that
# disagree about the clock produce alerts that are wrong in ways nobody notices.
TZ=Europe/Istanbul

# Host path where NCE's SavedCopies folder is mounted, READ-ONLY. Mount it on the host first, e.g.
#
#   mkdir -p /mnt/nce
#   printf 'username=<ro-user>\npassword=<ro-pass>\n' > /root/.nce-credentials
#   chmod 600 /root/.nce-credentials
#   mount -t cifs //<nce-server>/SavedCopies /mnt/nce \
#         -o ro,credentials=/root/.nce-credentials,uid=10001,gid=10001,iocharset=utf8
#
# uid/gid 10001 is the bridge container's user (see homunculus-engine/Dockerfile) — without them the
# container can list the directory but not open the files, which looks like an empty share.
# Read-only is not a precaution here, it is the design: the NCE box is a live clinical system that
# four devices have depended on since 2020, and this pilot must not be able to write to it.
NCE_SHARE_PATH=/mnt/nce
