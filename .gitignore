# Obsidian's per-machine UI state — pane layout, graph camera position. It changes every time the
# vault is opened and means nothing to anyone else. These patterns need the leading ** because a
# pattern containing a slash is anchored to this file's directory, and the vault lives one level
# down in Homunculus/ — which is why the earlier, unanchored version never matched.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/graph.json
.DS_Store
Thumbs.db
.claude/settings.local.json

# runtime audit databases (synthetic data only, never committed)
*.db
*.db-journal
*.db-wal
*.db.identity
*.db.identity-journal
.test-tmp-*/

# Edge bridge deployment secrets — the tenant token authorises /ingest, so this must never be
# committed. .env.example carries the shape; .env carries the value.
deploy/bridge/.env
deploy/bridge/site-mapping.json

# Local on-prem deployment configuration (secrets, site mapping)
deploy/local/.env
deploy/local/site-mapping.json
# Per-hospital HIS-bed -> our-bed table. Names the site's wards and room numbers, so it is site
# detail rather than product. bed-mapping.example.json carries the shape.
deploy/local/bed-mapping.json
# The domain controller's CA certificate: public, but site-specific.
deploy/local/ldap-ca/
# Aşama A's DEPLOYED device->bed table: a copy of deploy/infinity/device-beds.icu2.json, installed
# with its sha256 checked. The reviewed, approved source of record is that repo file, not this.
deploy/local/infinity-shadow/

# Python bytecode. Never useful in a diff, and it pulled a compiled copy of a deleted module along
# with it.
__pycache__/
*.pyc

# Mobile app build + dependency output
homunculus-mobile/node_modules/
homunculus-mobile/.expo/
homunculus-mobile/dist/
homunculus-mobile/web-build/

# Site photos and any camera captures from the hospital: they can carry live patient traces,
# ward backgrounds, service passwords and internal network detail. These must never be
# committed — the repo is private today, but a photo that leaks a ward or a password is not
# something a visibility setting should be the only thing standing in front of. Sanitised text
# captures of the same facts live in Homunculus/raw/.
site-photos/
Homunculus/raw/dragger/

# MEDIBUS site mapping (per-hospital device table; the example file is the shape)
medibus/medibus-mapping.json
