# Copy to `.env` next to docker-compose.yml, fill in, and lock it down:
#   cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored. Nothing in this file may be committed with a real value.

# Postgres. This database holds real patient data; treat the password accordingly.
#
# Generate it — do not invent one:
#   openssl rand -base64 36
#
# It must NOT contain an "@". This value is interpolated into DATABASE_URL
# (postgresql://homunculus:<password>@postgres:5432/homunculus), and an "@" splits the URL in the
# wrong place: the host becomes something like "cd@postgres" and the API fails with a name
# resolution error that never mentions the password. `openssl rand -base64` cannot emit "@", which
# is the other reason to generate rather than invent. "/", "+" and "=" are all safe.
#
# Deliberately blank: there is no placeholder to forget. REQUIRED: compose refuses to start
# without it.
POSTGRES_PASSWORD=

# Signing key for session tokens. REQUIRED: compose refuses to start without it, and the API
# refuses a key shorter than 32 characters. Generate one, do not invent one:
#   openssl rand -base64 36
JWT_SECRET=

# Tenant bearer token used by the bridge to POST observations. This is a WRITE credential: it
# authorises /ingest. REQUIRED: compose refuses to start without it. Generate it the same way as
# JWT_SECRET; do not reuse "pilot-token":
#   openssl rand -base64 36
TENANT_TOKEN=

# The tenant slug this deployment runs as. This is not just a label: it IS the engine's hospital
# key. docker-compose.yml uses it twice — once in TENANTS (so the bridge's token and any clinician
# JWT resolve to this hospital) and once in SEED_TENANT_SLUG (so seed_admin.py creates the admin
# account under that same hospital). If those two ever named different slugs, the admin would be
# seeded into a tenant nothing else points at: login would succeed, but the board — and everything
# the bridge feeds in — would silently stay empty, because the pieces would each be talking about a
# different hospital that happens to share a token. Leave it as the default unless you know you are
# running more than one tenant on this host.
TENANT_SLUG=demo-hastanesi

# First administrator, created on the first start in the tenant's `hospital_admin` group (the
# system group, which holds every permission and requires MFA: the first sign-in enrols an
# authenticator, then replaces this password with one the administrator chooses — it was typed
# into this file). The address becomes the account's username AND e-mail: no spaces, exactly one
# "@" with text on both sides, at most 128 characters.
#
# SEED_ADMIN_PASSWORD is deliberately blank. Fill it in for the first start: at least 12
# characters and not a known placeholder (change-me, password, ...). The seed refuses anything
# weaker, and a fresh install would then have NO administrator (the refusal is in the API log).
# Blank, the seed is skipped, so remove the value again once the administrator exists.
#
# NOTE: seeding is idempotent and SKIPS an existing user. Changing this password later does NOT
# change the account's password: the administrator changes it in the dashboard (user menu,
# "Parolamı değiştir"). Keep at least two local administrators, each with their own
# authenticator (docs/superpowers/plans/2026-09-23-rbac-groups-permissions.md, Task 20).
SEED_ADMIN_EMAIL=admin@hastane.com.tr
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Sistem Yöneticisi

# The interface the MLLP port binds to — the one facing the device network, never 0.0.0.0.
# MLLP is plain text with no authentication.
LISTEN_ADDR=172.100.101.72

# The interface the dashboard is served on.
WEB_LISTEN_ADDR=172.100.101.72

# HTTPS port for the dashboard. Browser notifications (critical alarm push) only work on a
# secure origin, so clinicians should open https://<WEB_LISTEN_ADDR>:<WEB_TLS_PORT>. The
# certificate is self-signed and minted automatically on first start; each browser shows one
# security warning to accept ("Advanced -> Proceed"), once per machine.
WEB_TLS_PORT=8443

# Encryption key for patient identities at rest, in the API and the bridge. REQUIRED: compose
# refuses to start without it, the API refuses to boot on a malformed one. Generate once, before
# the first real admission, and keep it with the backups — rows written under one key cannot be
# read under another (names go blank on the board; the readings are unaffected):
#   openssl rand -base64 32 | tr '+/' '-_'
# or python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHI_ENCRYPTION_KEY=

# Host port for the dashboard. 80 unless something already owns it — a server that has run anything
# else web-facing usually has Apache or nginx holding *:80 on every interface, and Docker then
# fails to bind with "address already in use". Moving this is far less disruptive than stopping
# whatever that other service is doing.
WEB_PORT=80

# Container timezone. The engine reasons about observation timestamps, so a host and a monitor that
# disagree about the clock produce alerts that are wrong in ways nobody notices.
TZ=Europe/Istanbul

# Host path where NCE's SavedCopies folder is mounted, READ-ONLY. Mount it on the host first, e.g.
#
#   mkdir -p /mnt/nce
#   printf 'username=<ro-user>\npassword=<ro-pass>\n' > /root/.nce-credentials
#   chmod 600 /root/.nce-credentials
#   mount -t cifs //<nce-server>/SavedCopies /mnt/nce \
#         -o ro,credentials=/root/.nce-credentials,uid=10001,gid=10001,iocharset=utf8
#
# uid/gid 10001 is the bridge container's user (see homunculus-engine/Dockerfile) — without them the
# container can list the directory but not open the files, which looks like an empty share.
# Read-only is not a precaution here, it is the design: the NCE box is a live clinical system that
# four devices have depended on since 2020, and this pilot must not be able to write to it.
NCE_SHARE_PATH=/mnt/nce

# ---------------------------------------------------------------------------------------
# Infinity research window (optional). Shows the Dräger monitors' decoded parameter records
# on the device page for BIOMEDICAL / HOSPITAL_ADMIN. Candidate values, never observations.
#
# All three must be set or the page reports "not configured" — nothing defaults, so a
# half-filled file cannot point the API at a hub it will then trust. The hub URL MUST be
# https: the credential rides in a header and the API refuses to send it in the clear.
#
# INFINITY_VIEWER_TOKEN is the research hub's VIEWER credential (from the hub's own config,
# INFINITY_VIEWER_TOKEN in /etc/homunculus-infinity-pilot/hub.env on the hub host). Not the
# collector token — that one authorises writing packets and never belongs in this container.
#
# INFINITY_HUB_CA_HOST_PATH is a copy of the hub's PUBLIC certificate (ca.pem), readable by
# the container: copy it out of the hub's config directory with mode 644 rather than mounting
# that directory, which also holds the TLS private key.
#INFINITY_HUB_URL=https://172.100.101.72:8766
#INFINITY_VIEWER_TOKEN=
#INFINITY_HUB_CA_HOST_PATH=/etc/homunculus/infinity-ca.pem
#INFINITY_HUB_CA_FILE=/etc/homunculus/infinity-ca.pem

# ---------------------------------------------------------------------------------------
# Active Directory sign-in (optional). LDAP_URL unset = off: only local accounts sign in, AD
# accounts get "Dizin sunucusuna ulaşılamıyor", and the AD admin panel hides itself. See
# docs/EDGE-BRIDGE-LOCAL.md, "Active Directory sign-in (optional)".
#
# LDAPS only: ldaps://<the DC's name exactly as in its certificate>:636. Put the CA that signed
# the DC's certificate in deploy/local/ldap-ca/ca.pem (public; mounted read-only). A setting
# the API cannot use is logged ("LDAP is OFF: ...") and leaves AD sign-in off; it never stops
# the API, and local accounts always keep working.
#
# The bind account is a READ-ONLY service account. Its password lives here and nowhere else
# (never in the database, never in a response). If it contains a "$", single-quote the value.
#LDAP_URL=ldaps://dc1.hastane.local:636
#LDAP_CA_CERT=/etc/homunculus/ldap-ca/ca.pem
#LDAP_BIND_DN=CN=svc-homunculus,OU=Service Accounts,DC=hastane,DC=local
#LDAP_BIND_PASSWORD=
#LDAP_BASE_DN=DC=hastane,DC=local
# Optional; the defaults are shown:
#LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
#LDAP_LOGIN_ATTRS=sAMAccountName,userPrincipalName,mail
#LDAP_NESTED_GROUPS=1
#LDAP_TIMEOUT_S=5
# Lab only, never in the hospital: permits ldap:// and, without LDAP_CA_CERT, an unverified
# certificate. The API logs a warning at every start while it is set.
#LDAP_ALLOW_INSECURE=0

# ---------------------------------------------------------------------------------------
# Screen lock on the ward PCs (optional). After this many minutes without a key press, click or
# touch, the dashboard hides every patient and asks for the user's password again (a minute's
# warning first). 1-60; unset = 10. A value the API cannot use is logged and 10 applies.
# There is no "never": a personal session always locks (a wall display is Group 2's kiosk mode).
#SCREEN_LOCK_IDLE_MINUTES=10
# A browser that stays locked this many hours signs itself out (1-72; unset = 12).
#SCREEN_LOCK_SIGNOUT_HOURS=12
