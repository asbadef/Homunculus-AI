# Homunculus API — FastAPI, the clinical engine, the escalation loop and the audit trail.
#
# Unlike the edge bridge (standard library only, see Dockerfile), this image installs the project's
# dependencies: FastAPI, SQLAlchemy, asyncpg, Alembic, bcrypt, pyotp — at the exact versions in
# constraints.txt, the set the test suite ran against on Python 3.12. Without them a rebuild takes
# whatever was released since: SQLAlchemy 2.1 once arrived without greenlet, and the API could not
# import its database layer.
#
# Build from the homunculus-engine directory:
#   docker build -t homunculus-api -f Dockerfile.api .

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Copy pyproject and source; install dependencies before copying scripts and migrations.
# This way, changes to scripts/alembic do not invalidate the pip layer.
# PIP_CONSTRAINT pins the build backend (setuptools) in pip's isolated build environment,
# which `-c constraints.txt` does not reach (build-constraints.txt says why). The in-tree
# build leaves /app/build behind: removed.
COPY pyproject.toml constraints.txt build-constraints.txt /app/
COPY src/ /app/src/
RUN PIP_CONSTRAINT=/app/build-constraints.txt pip install --no-cache-dir -c constraints.txt . \
    && rm -rf /app/build \
    && useradd --system --uid 10002 --home /app homunculus \
    && chown -R homunculus:homunculus /app

# Copy scripts and migrations after pip install so changes to these do not invalidate the dependency layer.
# --chown applies the user created in the RUN above, ensuring files are not owned by root.
COPY --chown=homunculus:homunculus scripts/ /app/scripts/
COPY --chown=homunculus:homunculus alembic/ /app/alembic/
COPY --chown=homunculus:homunculus alembic.ini /app/

USER homunculus

EXPOSE 8000

# Liveness probe: the app exposes /health for orchestrator health checks.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status==200 else 1)"

# Migrate, then bootstrap the first admin, then serve. seed_admin.py is idempotent and exits 0 when
# SEED_ADMIN_PASSWORD is unset, so restarts keep working after the operator removes the password.
# exec is used so uvicorn becomes PID 1 and receives SIGTERM on container shutdown (not sh).
# --workers must stay 1 (uvicorn's default; do not add the flag): state that has to be one per
# server lives in this process's memory - the wait of an admission form sent again (amendment
# A-29, admission/router.py `_ANSWERING`) and the sign-in attempt limits (auth/limits.py), with
# the engine and the board. A second worker would hold its own copies of each.
CMD ["sh", "-c", "alembic upgrade head && python scripts/seed_admin.py && exec uvicorn homunculus.api.prodserver:app --host 0.0.0.0 --port 8000"]
