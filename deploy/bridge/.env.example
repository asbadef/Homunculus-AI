# Copy to `.env` next to docker-compose.yml and fill in. `.env` is gitignored — the token must
# never be committed.
#
#   cp .env.example .env && chmod 600 .env

# GHCR account that owns the image (the GitHub repository owner).
GHCR_OWNER=asbadef

# `latest`, or a long sha tag to pin the pilot to the exact build it was validated against.
# Pinning is the right choice once a device is connected: "latest" cannot answer the question
# "what is running on the ward right now?".
IMAGE_TAG=latest

# Host address the MLLP port binds to. This MUST be the specific interface that faces the device
# network — never 0.0.0.0.
#
# MLLP carries HL7 in plain text with no encryption and no authentication. If this host has any
# interface on a publicly routable address, binding 0.0.0.0 publishes patient data to the internet
# for anyone who connects to the port.
#
# Check the address before assuming it is internal. Only 10/8, 172.16-172.31/12 and 192.168/16 are
# private: 172.100.x.x, for instance, looks internal at a glance and is globally routable.
LISTEN_ADDR=10.10.96.50

# The cloud API the bridge forwards to. Outbound HTTPS only; the device never talks to it.
CLOUD_URL=https://homunculus-api-bkrf.onrender.com

# Tenant bearer token, matching a TENANTS entry on the API.
# This is a write credential: it authorises /ingest. Treat it like a password, and do not reuse the
# placeholder value from the development setup.
TENANT_TOKEN=change-me

# The container's timezone. The engine reasons about observation timestamps, so a host and device
# that disagree about the clock produce alerts that are wrong in ways nobody notices.
TZ=Europe/Istanbul
